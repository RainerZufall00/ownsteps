<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the app: account list, upload folder, inbox. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(APP_BUNDLE_ID_PREFIX).app</string>
	</array>
	<!-- The device tokens the app saved. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID_PREFIX).shared</string>
	</array>
</dict>
</plist>
