    "A ZIP with one page and all photos and videos, the text, the captions and a map of the route. It opens in any browser, also offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ZIP-Datei mit einer Seite und allen Fotos und Videos, den Texten, Bildbeschreibungen und einer Karte der Route. Sie öffnet sich in jedem Browser, auch offline."
          }
        }
      }
    },
