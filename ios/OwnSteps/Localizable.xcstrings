      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte E-Mail und Passwort eingeben."
          }
        }
      }
    },
    "Please enter your server's address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gib die Adresse deines Servers ein."
          }
        }
      }
    },
