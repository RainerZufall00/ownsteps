        }
      }
    },
    "The trip's name is too long.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name der Reise ist zu lang."
          }
        }
      }
    },
    "These photos were taken in different places. The step appears on the map at the one you pick; each photo keeps its own position.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fotos wurden an verschiedenen Orten aufgenommen. Die Station erscheint auf der Karte an dem Ort, den du wählst; jedes Foto behält seine eigene Position."
          }
        }
      }
    },
    "They can follow again with the link, unless you create a new one in the web.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Link können sie wieder folgen, außer du erzeugst im Web einen neuen."
          }
        }
      }
    },
    "This account isn't allowed on this server.": {
      "localizations": {
