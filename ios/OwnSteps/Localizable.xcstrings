          }
        }
      }
    },
    "The cover appears in the overview and in link previews. Unlike the other photos, it's public once the trip is shared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Titelbild erscheint in der Übersicht und in Linkvorschauen. Anders als die übrigen Fotos ist es öffentlich, sobald die Reise geteilt wird."
          }
        }
      }
    },
    "The file is gone from the device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist nicht mehr auf dem Gerät."
          }
        }
      }
    },
