            "value": "Anmelden"
          }
        }
      }
    },
    "Sign in with %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ anmelden"
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        }
      }
    },
    "Sign out of this server?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Server abmelden?"
          }
        }
      }
    },
    "Sign-in couldn't be completed. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung konnte nicht abgeschlossen werden. Bitte noch einmal versuchen."
          }
        }
      }
    },
    "Sign-in failed. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist fehlgeschlagen. Bitte noch einmal versuchen."
          }
        }
      }
    },
    "Sign-in took too long. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung hat zu lange gedauert. Bitte noch einmal versuchen."
          }
        }
      }
    },
    "Sign-in was cancelled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde abgebrochen."
          }
        }
      }
    },
    "Steps appear here once the trip gets going.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen die Beiträge, sobald die Reise losgeht."
          }
        }
      }
    },
    "Tap to read": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antippen zum Lesen"
          }
        }
      }
    },
    "That doesn't look like a web address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer Web-Adresse aus."
          }
        }
      }
    },
    "The address you open OwnSteps at in the browser.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, unter der du OwnSteps im Browser öffnest."
          }
        }
      }
    },
    "The server answered unexpectedly (%lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat unerwartet geantwortet (%lld)."
          }
        }
      }
    },
    "The server can't be reached. Check the address and your connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Prüfe die Adresse und deine Verbindung."
          }
        }
      }
    },
    "The server must use HTTPS. Plain HTTP only works inside your home network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server muss HTTPS verwenden. Unverschlüsseltes HTTP geht nur im Heimnetz."
          }
        }
      }
    },
    "The server reported an error (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat einen Fehler gemeldet (%@)."
          }
        }
      }
    },
    "This account isn't allowed on this server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Account ist auf diesem Server nicht freigegeben."
          }
        }
      }
    },
    "This device stops having access to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat danach keinen Zugriff mehr auf %@."
          }
        }
      }
    },
    "This server (version %@) doesn't fit this app version. Please update both.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server (Version %@) passt nicht zu dieser App-Version. Bitte beides aktualisieren."
          }
        }
      }
    },
    "This server isn't set up yet. Create the first account in the browser, then come back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist noch nicht eingerichtet. Lege den ersten Account im Browser an und komm dann zurück."
          }
        }
      }
    },
    "This server offers no way to sign in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server bietet keine Anmeldung an."
          }
        }
      }
    },
    "This trip isn't shared at the moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Reise ist gerade nicht freigegeben."
          }
        }
      }
    },
    "This trip no longer exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Reise gibt es nicht mehr."
          }
        }
      }
    },
