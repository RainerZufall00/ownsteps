# ---------------------------------------------------------------
# OwnSteps – configuration
# Copy to .env and adjust:  cp .env.example .env
#
# This file is a template and lives in the repository – no real
# credentials belong here. The actual values go into .env, which
# Git ignores.
#
# Values with special characters (#, spaces, quotes) belong in
# double quotes, otherwise the parser cuts them off at the first #:
#   ADMIN_PASSWORD="secret#123"
#
# OwnSteps checks these settings when it starts. A wrong value (a typo in
# true/false, half an OIDC setup …) stops it with a message naming the
# setting – see "docker compose logs ownsteps".
# ---------------------------------------------------------------

# Name shown in the app and in the browser tab.
SITE_NAME=OwnSteps

# Public address of the instance, without a trailing slash.
# Needed for share links, preview images, the OIDC callback and the
# map. Must match the address the app is opened under – so leave it
# empty or set it to localhost for local development.
PUBLIC_URL=https://trips.example.com

# Signs the share-link cookies. If left empty, one is generated on
# first start and stored in data/.secret. If set, it must be at least 32
# random characters – the server refuses to start with a weaker one.
# Generate one yourself:  openssl rand -base64 32
APP_SECRET=

# How many reverse proxies in front of OwnSteps add to X-Forwarded-For.
# The brakes against password guessing count per client address, which is
# taken from that header – counted from the right, because entries further
# left come from the client and can be faked. One proxy (Caddy, nginx,
# Traefik, Pangolin) is the default; two if e.g. Cloudflare sits in front of
# it; 0 if the server is reachable directly.
TRUSTED_PROXIES=1

# ---------------------------------------------------------------
# Network
# ---------------------------------------------------------------
# Port on the host. Inside the container the app always runs on 2555.
# Do NOT set PORT here – that would change the container port while
# the mapping in docker-compose.yml stays the same.
HOST_PORT=2555

# Address the port is bound to. If a reverse proxy or tunnel client
# runs on the same server, put 127.0.0.1 here – the port is then only
# reachable locally. Without a proxy leave it at 0.0.0.0.
# Note: Docker opens published ports past ufw. With 0.0.0.0 on a server
# with a public IP, anyone can reach OwnSteps without your proxy – if the
# proxy runs elsewhere, allow the port only from it in your provider's
# firewall.
BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------
# Map and place names
# Without a key the map comes from OpenFreeMap and place names from
# OpenStreetMap (Nominatim, Photon) – free, no account needed.
# With a MapTiler key both come from MapTiler, which also has satellite
# maps. Free key: https://cloud.maptiler.com/account/keys/
# The key never leaves the server – map requests go through /api/map.
# ---------------------------------------------------------------
MAPTILER_KEY=
# Map style. With MapTiler: hybrid (satellite with labels), satellite,
# streets-v2, outdoor-v2, landscape, winter-v2, topo-v2 …
# Without a key: liberty, bright or positron (anything else: liberty).
MAP_STYLE=hybrid
# Set to "off" to send no coordinates or searches to any service; place
# names are then typed by hand.
GEOCODING=on

# ---------------------------------------------------------------
# Sign-in via OIDC (e.g. Pocket ID) – optional
# Create an OIDC client with your provider and register as callback URL:
#   https://trips.example.com/api/auth/oidc/callback
# ---------------------------------------------------------------
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Label of the sign-in button.
OIDC_BUTTON_LABEL=Pocket ID
# Optional: only these addresses may sign in (comma-separated).
# Empty = everyone who can sign in with the provider gets access.
OIDC_ALLOWED_EMAILS=
# Accounts are only matched by email addresses the provider marks as
# verified. Only for providers that check them but never say so:
# OIDC_TRUST_EMAIL=true

# Set to "false" to switch password sign-in off everywhere (web and app),
# e.g. once OIDC is set up. Initial setup still works with a password.
PASSWORD_LOGIN=true

# ---------------------------------------------------------------
# iOS app (optional)
# ---------------------------------------------------------------
# Numeric App Store ID of the OwnSteps app. Enables the Smart App
# Banner and the "open in app" button on shared trips.
APP_STORE_ID=

# ---------------------------------------------------------------
# First account (optional)
# Only needed if initial setup shouldn't happen through the web
# interface. Created on the very first start.
# ---------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---------------------------------------------------------------
# Storage
# ---------------------------------------------------------------
# Keep the original files in addition to the web sizes (default: true).
# Set to "false" when disk space is tight.
KEEP_ORIGINALS=true
