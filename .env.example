# ---------------------------------------------------------------
# OwnSteps – Konfiguration
# Kopieren nach .env und anpassen:  cp .env.example .env
#
# Diese Datei ist eine Vorlage und liegt im Repository – hier gehören
# keine echten Zugangsdaten hinein. Die tatsächlichen Werte stehen in
# .env, die von Git ignoriert wird.
#
# Werte mit Sonderzeichen (#, Leerzeichen, Anführungszeichen) gehören in
# doppelte Anführungszeichen, sonst schneidet der Parser am ersten # ab:
#   ADMIN_PASSWORD="geheim#123"
# ---------------------------------------------------------------

# Name, der in der App und im Browser-Tab steht.
SITE_NAME=OwnSteps

# Öffentliche Adresse der Instanz, ohne Schrägstrich am Ende.
# Wird für Share-Links, Vorschaubilder, den OIDC-Callback und die Karte
# gebraucht. Muss zu der Adresse passen, unter der die App aufgerufen wird –
# beim lokalen Entwickeln also leer lassen oder auf localhost setzen.
PUBLIC_URL=https://reisen.beispiel.de

# Signiert die Cookies der Share-Links. Bleibt leer, wird beim ersten Start
# automatisch eines erzeugt und in data/.secret abgelegt.
# Selbst erzeugen:  openssl rand -base64 32
APP_SECRET=

# ---------------------------------------------------------------
# Netzwerk
# ---------------------------------------------------------------
# Port auf dem Host. Im Container läuft die App fest auf 2555.
# PORT hier NICHT setzen – das würde den Container-Port verstellen,
# während das Mapping in docker-compose.yml unverändert bliebe.
HOST_PORT=2555

# Adresse, auf der der Port gebunden wird. Steht ein Reverse Proxy oder
# Tunnel-Client auf demselben Server, gehört hier 127.0.0.1 hin – der Port
# ist dann nur lokal erreichbar. Ohne Proxy 0.0.0.0 lassen.
BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------
# Karte (MapTiler)
# Kostenlosen Key holen: https://cloud.maptiler.com/account/keys/
# Der Key verlässt den Server nie – Kartenabrufe laufen über /api/map.
# ---------------------------------------------------------------
MAPTILER_KEY=
# Stil der Karte: hybrid (Satellit mit Beschriftung), satellite, streets-v2,
# outdoor-v2, landscape, winter-v2, topo-v2 …
MAP_STYLE=hybrid

# ---------------------------------------------------------------
# Anmeldung über Pocket ID (OIDC) – optional
# In Pocket ID einen OIDC-Client anlegen und als Callback-URL eintragen:
#   https://reisen.beispiel.de/api/auth/oidc/callback
# ---------------------------------------------------------------
OIDC_ISSUER=https://id.beispiel.de
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Beschriftung des Anmelde-Buttons.
OIDC_BUTTON_LABEL=Pocket ID
# Optional: nur diese Adressen dürfen sich anmelden (kommagetrennt).
# Leer = jeder, der sich bei Pocket ID anmelden kann, bekommt Zugang.
OIDC_ALLOWED_EMAILS=

# ---------------------------------------------------------------
# Erster Account (optional)
# Nur nötig, wenn die Ersteinrichtung nicht über die Weboberfläche
# laufen soll. Wird beim allerersten Start angelegt.
# ---------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---------------------------------------------------------------
# Speicher
# ---------------------------------------------------------------
# Originaldateien zusätzlich zu den Web-Größen aufheben (Standard: true).
# Auf "false" stellen, wenn der Plattenplatz knapp ist.
KEEP_ORIGINALS=true
